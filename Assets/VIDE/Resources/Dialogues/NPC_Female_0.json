25_com_0iSet":25,"pd_25_com_0oAns":26,"pd_25_com_0oAct":-1,"pd_25_com_0text":"Widzisz, ka\u017cdy kosmonauta codziennie du\u017co trenuje... \u0106wiczenia fizyczne przeciwdzia\u0142aj\u0105 zanikowi mi\u0119\u015bni oraz os\u0142abieniu ko\u015bci, kt\u00f3re w niewa\u017cko\u015bci nie s\u0105 tak obci\u0105\u017cane jak na Ziemi. Regularny trening pomaga te\u017c utrzyma\u0107 dobr\u0105 wydolno\u015b\u0107 serca i uk\u0142adu kr\u0105\u017cenia.","pd_25_com_0extraD":"ExtraData","pd_25_com_0showmore":false,"pd_25_com_0visible":true,"pd_25_com_0audio":"","pd_25_com_0sprite":"","pd_isp_26":false,"pd_rect_26":[6960,660],"pd_comSize_26":2,"pd_ID_26":26,"pd_pTag_26":"","pd_sprite_26":"","pd_expand_26":false,"pd_vars26":0,"pd_26_com_0iSet":26,"pd_26_com_0oAns":27,"pd_26_com_0oAct":-1,"pd_26_com_0text":"Dobra, dosy\u0107 gadania! Pora na dzia\u0142anie, a w\u0142a\u015bciwie na Tw\u00f3j spacer kosmiczny. ","pd_26_com_0extraD":"ExtraData","pd_26_com_0showmore":false,"pd_26_com_0visible":true,"pd_26_com_0audio":"","pd_26_com_0sprite":"","pd_26_com_1iSet":26,"pd_26_com_1oAns":-1,"pd_26_com_1oAct":-1,"pd_26_com_1text":"Wejd\u017a w skafander po Twojej lewej i id\u017a na wprost.","pd_26_com_1extraD":"ExtraData","pd_26_com_1showmore":false,"pd_26_com_1visible":true,"pd_26_com_1audio":"","pd_26_com_1sprite":"","pd_isp_27":true,"pd_rect_27":[7340,660],"pd_comSize_27":3,"pd_ID_27":28,"pd_pTag_27":"","pd_sprite_27":"","pd_expand_27":false,"pd_vars27":0,"pd_27_com_0iSet":-1,"pd_27_com_0oAns":-1,"pd_27_com_0oAct":-1,"pd_27_com_0text":"Jasne, dzi\u0119ki!","pd_27_com_0extraD":"ExtraData","pd_27_com_0showmore":false,"pd_27_com_0visible":true,"pd_27_com_0audio":"","pd_27_com_0sprite":"","pd_27_com_1iSet":27,"pd_27_com_1oAns":-1,"pd_27_com_1oAct":-1,"pd_27_com_1text":"No dobra\u2026 Trzymaj kciuki.","pd_27_com_1extraD":"ExtraData","pd_27_com_1showmore":false,"pd_27_com_1visible":true,"pd_27_com_1audio":"","pd_27_com_1sprite":"","pd_27_com_2iSet":27,"pd_27_com_2oAns":-1,"pd_27_com_2oA