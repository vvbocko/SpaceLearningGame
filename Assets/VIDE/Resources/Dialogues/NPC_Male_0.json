{"dID":14313,"playerDiags":30,"actionNodes":0,"startPoint":0,"loadTag":"","previewPanning":false,"autosave":true,"locEdit":false,"showSettings":true,"pd_isp_0":false,"pd_rect_0":[-10,-40],"pd_comSize_0":2,"pd_ID_0":0,"pd_pTag_0":"","pd_sprite_0":"","pd_expand_0":false,"pd_vars0":0,"pd_0_com_0iSet":0,"pd_0_com_0oAns":1,"pd_0_com_0oAct":-1,"pd_0_com_0text":"Hej, jestem Mateusz i w imieniu za\u0142ogi: witamy na Mi\u0119dzynarodowej Stacji Kosmicznej (ISS)!","pd_0_com_0extraD":"ExtraData","pd_0_com_0showmore":false,"pd_0_com_0visible":true,"pd_0_com_0audio":"","pd_0_com_0sprite":"","pd_0_com_1iSet":0,"pd_0_com_1oAns":-1,"pd_0_com_1oAct":-1,"pd_0_com_1text":"Jak si\u0119 czujesz?","pd_0_com_1extraD":"ExtraData","pd_0_com_1showmore":false,"pd_0_com_1visible":true,"pd_0_com_1audio":"","pd_0_com_1sprite":"","pd_isp_1":true,"pd_rect_1":[380,-60],"pd_comSize_1":3,"pd_ID_1":1,"pd_pTag_1":"","pd_sprite_1":"","pd_expand_1":false,"pd_vars1":0,"pd_1_com_0iSet":1,"pd_1_com_0oAns":4,"pd_1_com_0oAct":-1,"pd_1_com_0text":"Czuj\u0119 si\u0119 dziwnie, wszystko si\u0119 unosi\u2026","pd_1_com_0extraD":"ExtraData","pd_1_com_0showmore":false,"pd_1_com_0visible":true,"pd_1_com_0audio":"","pd_1_com_0sprite":"","pd_1_com_1iSet":1,"pd_1_com_1oAns":5,"pd_1_com_1oAct":-1,"pd_1_com_1text":"To niesamowite! Czuj\u0119 si\u0119 jak ryba w wodzie.","pd_1_com_1extraD":"ExtraData","pd_1_com_1showmore":false,"pd_1_com_1visible":true,"pd_1_com_1audio":"","pd_1_com_1sprite":"","pd_1_com_2iSet":1,"pd_1_com_2oAns":6,"pd_1_com_2oAct":-1,"pd_1_com_2text":"Troch\u0119 mi niedobrze.","pd_1_com_2extraD":"ExtraData","pd_1_com_2showmore":false,"pd_1_com_2visible":true,"pd_1_com_2audio":"","pd_1_com_2sprite":"","pd_isp_2":true,"pd_rect_2":[1630,-70],"pd_comSize_2":4,"pd_ID_2":3,"pd_pTag_2":"","pd_sprite_2":"","pd_expand_2":false,"pd_vars2":0,"pd_2_com_0iSet":2,"pd_2_com_0oAns":9,"pd_2_com_0oAct":-1,"pd_2_com_0text":"Bo s\u0105 lekkie jak pi\u00f3rko - nie ma grawitacji.","pd_2_com_0extraD":"ExtraData","pd_2_com_0showmore":false,"pd_2_com_0visible":true,"pd_2_com_0audio":"","pd_2_com_0sprite":"","pd_2_com_1iSet":2,"pd_2_com_1oAns":8,"pd_2_com_1oAct":-1,"pd_2_com_1text":"Rzeczy maj\u0105 mas\u0119, Ziemia ma mas\u0119, wi\u0119c grawitacja dzia\u0142a!","pd_2_com_1extraD":"ExtraData","pd_2_com_1showmore":false,"pd_2_com_1visible":true,"pd_2_com_1audio":"","pd_2_com_1sprite":"","pd_2_com_2iSet":2,"pd_2_com_2oAns":7,"pd_2_com_2oAct":-1,"pd_2_com_2text":"Czy to znaczy, \u017ce tu nie dzia\u0142a grawitacja?","pd_2_com_2extraD":"ExtraData","pd_2_com_2showmore":false,"pd_2_com_2visible":true,"pd_2_com_2audio":"","pd_2_com_2sprite":"","pd_2_com_3iSet":2,"pd_2_com_3oAns":-1,"pd_2_com_3oAct":-1,"pd_2_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_2_com_3extraD":"ExtraData","pd_2_com_3showmore":false,"pd_2_com_3visible":true,"pd_2_com_3audio":"","pd_2_com_3sprite":"","pd_isp_3":false,"pd_rect_3":[1180,-90],"pd_comSize_3":2,"pd_ID_3":4,"pd_pTag_3":"","pd_sprite_3":"","pd_expand_3":false,"pd_vars3":0,"pd_3_com_0iSet":3,"pd_3_com_0oAns":2,"pd_3_com_0oAct":-1,"pd_3_com_0text":"Wyobra\u017a sobie, \u017ce nurkujesz! Twoje cia\u0142o unosi si\u0119 i wystarczy delikatne pchni\u0119cie, by pop\u0142yn\u0105\u0107, gdzie tylko chcesz.","pd_3_com_0extraD":"ExtraData","pd_3_com_0showmore":false,"pd_3_com_0visible":true,"pd_3_com_0audio":"","pd_3_com_0sprite":"","pd_3_com_1iSet":3,"pd_3_com_1oAns":-1,"pd_3_com_1oAct":-1,"pd_3_com_1text":"Oczywi\u015bcie, na orbicie jest nieco inaczej\u2026 Panuje tu stan mikrograwitacji i ka\u017cdy przedmiot czy cz\u0142owiek mog\u0105 wydawa\u0107 si\u0119 lekkie jak pi\u00f3rko.","pd_3_com_1extraD":"ExtraData","pd_3_com_1showmore":false,"pd_3_com_1visible":true,"pd_3_com_1audio":"","pd_3_com_1sprite":"","pd_isp_4":false,"pd_rect_4":[770,-210],"pd_comSize_4":1,"pd_ID_4":2,"pd_pTag_4":"","pd_sprite_4":"","pd_expand_4":false,"pd_vars4":0,"pd_4_com_0iSet":4,"pd_4_com_0oAns":3,"pd_4_com_0oAct":-1,"pd_4_com_0text":"Nie ma co si\u0119 dziwi\u0107! Ci\u0119\u017cko to por\u00f3wna\u0107 do czegokolwiek na Ziemi. Cho\u0107 przychodzi mi na my\u015bl jedna rzecz\u2026","pd_4_com_0extraD":"ExtraData","pd_4_com_0showmore":false,"pd_4_com_0visible":true,"pd_4_com_0audio":"","pd_4_com_0sprite":"","pd_isp_5":false,"pd_rect_5":[770,-50],"pd_comSize_5":1,"pd_ID_5":6,"pd_pTag_5":"","pd_sprite_5":"","pd_expand_5":false,"pd_vars5":0,"pd_5_com_0iSet":5,"pd_5_com_0oAns":3,"pd_5_com_0oAct":-1,"pd_5_com_0text":"Ha! To dobra metafora tego, co si\u0119 dzieje.","pd_5_com_0extraD":"ExtraData","pd_5_com_0showmore":false,"pd_5_com_0visible":true,"pd_5_com_0audio":"","pd_5_com_0sprite":"","pd_isp_6":false,"pd_rect_6":[770,80],"pd_comSize_6":2,"pd_ID_6":7,"pd_pTag_6":"","pd_sprite_6":"","pd_expand_6":false,"pd_vars6":0,"pd_6_com_0iSet":6,"pd_6_com_0oAns":3,"pd_6_com_0oAct":-1,"pd_6_com_0text":"Przede wszystkim pami\u0119taj, \u017ce wszyscy przez to przechodzili\u015bmy i zawsze mo\u017cesz si\u0119 do nas zwr\u00f3ci\u0107","pd_6_com_0extraD":"ExtraData","pd_6_com_0showmore":false,"pd_6_com_0visible":true,"pd_6_com_0audio":"","pd_6_com_0sprite":"","pd_6_com_1iSet":6,"pd_6_com_1oAns":-1,"pd_6_com_1oAct":-1,"pd_6_com_1text":"Gdyby co\u015b si\u0119 dzia\u0142o, Wiktoria, nasz pok\u0142adowy doktor, jest tu\u017c za mn\u0105. A do tego czasu mog\u0119 Ci opowiedzie\u0107 pewn\u0105 analogi\u0119, kt\u00f3ra mo\u017ce Ci pom\u00f3c.","pd_6_com_1extraD":"ExtraData","pd_6_com_1showmore":false,"pd_6_com_1visible":true,"pd_6_com_1audio":"","pd_6_com_1sprite":"","pd_isp_7":false,"pd_rect_7":[2050,120],"pd_comSize_7":1,"pd_ID_7":5,"pd_pTag_7":"","pd_sprite_7":"","pd_expand_7":false,"pd_vars7":0,"pd_7_com_0iSet":7,"pd_7_com_0oAns":10,"pd_7_com_0oAct":-1,"pd_7_com_0text":"Grawitacja zawsze dzia\u0142a...","pd_7_com_0extraD":"ExtraData","pd_7_com_0showmore":false,"pd_7_com_0visible":true,"pd_7_com_0audio":"","pd_7_com_0sprite":"","pd_isp_8":false,"pd_rect_8":[2050,0],"pd_comSize_8":1,"pd_ID_8":8,"pd_pTag_8":"","pd_sprite_8":"","pd_expand_8":false,"pd_vars8":0,"pd_8_com_0iSet":8,"pd_8_com_0oAns":10,"pd_8_com_0oAct":-1,"pd_8_com_0text":"Dok\u0142adnie!","pd_8_com_0extraD":"ExtraData","pd_8_com_0showmore":false,"pd_8_com_0visible":true,"pd_8_com_0audio":"","pd_8_com_0sprite":"","pd_isp_9":false,"pd_rect_9":[2050,-120],"pd_comSize_9":1,"pd_ID_9":9,"pd_pTag_9":"","pd_sprite_9":"","pd_expand_9":false,"pd_vars9":0,"pd_9_com_0iSet":9,"pd_9_com_0oAns":10,"pd_9_com_0oAct":-1,"pd_9_com_0text":"Tak mog\u0142oby si\u0119 wydawa\u0107\u2026","pd_9_com_0extraD":"ExtraData","pd_9_com_0showmore":false,"pd_9_com_0visible":true,"pd_9_com_0audio":"","pd_9_com_0sprite":"","pd_isp_10":false,"pd_rect_10":[2430,-40],"pd_comSize_10":3,"pd_ID_10":10,"pd_pTag_10":"","pd_sprite_10":"","pd_expand_10":false,"pd_vars10":0,"pd_10_com_0iSet":10,"pd_10_com_0oAns":11,"pd_10_com_0oAct":-1,"pd_10_com_0text":"W zale\u017cno\u015bci od masy obiektu i odleg\u0142o\u015bci od niego, przyci\u0105ganie grawitacyjne mo\u017ce by\u0107 ogromne, jak w przypadku czarnej dziury, kt\u00f3ra ma ogromn\u0105 mas\u0119! ","pd_10_com_0extraD":"ExtraData","pd_10_com_0showmore":false,"pd_10_com_0visible":true,"pd_10_com_0audio":"","pd_10_com_0sprite":"","pd_10_com_1iSet":10,"pd_10_com_1oAns":-1,"pd_10_com_1oAct":-1,"pd_10_com_1text":"Natomiast je\u015bli jeste\u015bmy bardzo daleko od pewnego obiektu, to grawitacja mo\u017ce by\u0107 tak ma\u0142a, \u017ce prawie nieodczuwalna.","pd_10_com_1extraD":"ExtraData","pd_10_com_1showmore":false,"pd_10_com_1visible":true,"pd_10_com_1audio":"","pd_10_com_1sprite":"","pd_10_com_2iSet":10,"pd_10_com_2oAns":-1,"pd_10_com_2oAct":-1,"pd_10_com_2text":"Tak wi\u0119c to jak przyci\u0105ganie grawitacyjne dzia\u0142a na dwa obiekty zale\u017cy od ich mas oraz odleg\u0142o\u015bci mi\u0119dzy nimi.","pd_10_com_2extraD":"ExtraData","pd_10_com_2showmore":false,"pd_10_com_2visible":true,"pd_10_com_2audio":"","pd_10_com_2sprite":"","pd_isp_11":true,"pd_rect_11":[2820,-30],"pd_comSize_11":4,"pd_ID_11":11,"pd_pTag_11":"","pd_sprite_11":"","pd_expand_11":false,"pd_vars11":0,"pd_11_com_0iSet":11,"pd_11_com_0oAns":12,"pd_11_com_0oAct":-1,"pd_11_com_0text":"Skoro grawitacja dzia\u0142a, to dlaczego wszystko tutaj lata? Na Ziemi rzeczy spadaj\u0105.","pd_11_com_0extraD":"ExtraData","pd_11_com_0showmore":false,"pd_11_com_0visible":true,"pd_11_com_0audio":"","pd_11_com_0sprite":"","pd_11_com_1iSet":11,"pd_11_com_1oAns":13,"pd_11_com_1oAct":-1,"pd_11_com_1text":"Czyli jeste\u015bmy wystarczaj\u0105co daleko, \u017ceby nie odczuwa\u0107 przyci\u0105gania Ziemi?","pd_11_com_1extraD":"ExtraData","pd_11_com_1showmore":false,"pd_11_com_1visible":true,"pd_11_com_1audio":"","pd_11_com_1sprite":"","pd_11_com_2iSet":11,"pd_11_com_2oAns":14,"pd_11_com_2oAct":-1,"pd_11_com_2text":"Natomiast stacja kosmiczna jest w ruchu\u2026 To on jest kluczowy!","pd_11_com_2extraD":"ExtraData","pd_11_com_2showmore":false,"pd_11_com_2visible":true,"pd_11_com_2audio":"","pd_11_com_2sprite":"","pd_11_com_3iSet":11,"pd_11_com_3oAns":-1,"pd_11_com_3oAct":-1,"pd_11_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_11_com_3extraD":"ExtraData","pd_11_com_3showmore":false,"pd_11_com_3visible":true,"pd_11_com_3audio":"","pd_11_com_3sprite":"","pd_isp_12":false,"pd_rect_12":[3220,-190],"pd_comSize_12":1,"pd_ID_12":12,"pd_pTag_12":"","pd_sprite_12":"","pd_expand_12":false,"pd_vars12":0,"pd_12_com_0iSet":12,"pd_12_com_0oAns":15,"pd_12_com_0oAct":-1,"pd_12_com_0text":"To mo\u017ce Ci\u0119 troch\u0119 zaskoczy\u0107, ale w pewnym sensie ca\u0142y czas spadamy, przez co wydaje si\u0119, jakby\u015bmy latali. Panuje tu stan niewa\u017cko\u015bci.","pd_12_com_0extraD":"ExtraData","pd_12_com_0showmore":false,"pd_12_com_0visible":true,"pd_12_com_0audio":"","pd_12_com_0sprite":"","pd_isp_13":false,"pd_rect_13":[3220,-20],"pd_comSize_13":1,"pd_ID_13":13,"pd_pTag_13":"","pd_sprite_13":"","pd_expand_13":false,"pd_vars13":0,"pd_13_com_0iSet":13,"pd_13_com_0oAns":15,"pd_13_com_0oAct":-1,"pd_13_com_0text":"Wbrew pozorom grawitacja jest tutaj prawie tak samo silna jak na powierzchni! To, co czujemy jako niewa\u017cko\u015b\u0107, to efekt ci\u0105g\u0142ego spadania po orbicie.","pd_13_com_0extraD":"ExtraData","pd_13_com_0showmore":false,"pd_13_com_0visible":true,"pd_13_com_0audio":"","pd_13_com_0sprite":"","pd_isp_14":false,"pd_rect_14":[3220,150],"pd_comSize_14":1,"pd_ID_14":14,"pd_pTag_14":"","pd_sprite_14":"","pd_expand_14":false,"pd_vars14":0,"pd_14_com_0iSet":14,"pd_14_com_0oAns":15,"pd_14_com_0oAct":-1,"pd_14_com_0text":"Pe\u0142na zgoda! Si\u0142a grawitacji jest tutaj prawie tak samo silna jak na powierzchni. To, co czujemy jako niewa\u017cko\u015b\u0107, to efekt ci\u0105g\u0142ego spadania po orbicie.","pd_14_com_0extraD":"ExtraData","pd_14_com_0showmore":false,"pd_14_com_0visible":true,"pd_14_com_0audio":"","pd_14_com_0sprite":"","pd_isp_15":false,"pd_rect_15":[3600,-50],"pd_comSize_15":2,"pd_ID_15":15,"pd_pTag_15":"","pd_sprite_15":"","pd_expand_15":false,"pd_vars15":0,"pd_15_com_0iSet":15,"pd_15_com_0oAns":16,"pd_15_com_0oAct":-1,"pd_15_com_0text":"Mi\u0119dzynarodowa Stacja Kosmiczna porusza si\u0119 dooko\u0142a Ziemi z pr\u0119dko\u015bci\u0105 blisk\u0105 7,6 km/s. To oko\u0142o 8 razy szybciej ni\u017c pocisk wystrzelony z broni palnej! ","pd_15_com_0extraD":"ExtraData","pd_15_com_0showmore":false,"pd_15_com_0visible":true,"pd_15_com_0audio":"","pd_15_com_0sprite":"","pd_15_com_1iSet":15,"pd_15_com_1oAns":-1,"pd_15_com_1oAct":-1,"pd_15_com_1text":"To w\u0142a\u015bnie dzi\u0119ki takiej pr\u0119dko\u015bci potrafimy, mimo  przyci\u0105gania Ziemi, okr\u0105\u017ca\u0107 j\u0105 zamiast spa\u015b\u0107 - tak powstaje orbita.","pd_15_com_1extraD":"ExtraData","pd_15_com_1showmore":false,"pd_15_com_1visible":true,"pd_15_com_1audio":"","pd_15_com_1sprite":"","pd_isp_16":true,"pd_rect_16":[4000,-50],"pd_comSize_16":4,"pd_ID_16":16,"pd_pTag_16":"","pd_sprite_16":"","pd_expand_16":false,"pd_vars16":0,"pd_16_com_0iSet":16,"pd_16_com_0oAns":19,"pd_16_com_0oAct":-1,"pd_16_com_0text":"Wr\u00f3\u0107my do stanu niewa\u017cko\u015bci\u2026 ","pd_16_com_0extraD":"ExtraData","pd_16_com_0showmore":false,"pd_16_com_0visible":true,"pd_16_com_0audio":"","pd_16_com_0sprite":"","pd_16_com_1iSet":16,"pd_16_com_1oAns":17,"pd_16_com_1oAct":-1,"pd_16_com_1text":"Ci\u0105g\u0142e spadanie? Czy to znaczy, \u017ce co\u015b nam grozi?","pd_16_com_1extraD":"ExtraData","pd_16_com_1showmore":false,"pd_16_com_1visible":true,"pd_16_com_1audio":"","pd_16_com_1sprite":"","pd_16_com_2iSet":16,"pd_16_com_2oAns":18,"pd_16_com_2oAct":-1,"pd_16_com_2text":"Czyli dlatego czujemy si\u0119, jakby\u015bmy nic nie wa\u017cyli?","pd_16_com_2extraD":"ExtraData","pd_16_com_2showmore":false,"pd_16_com_2visible":true,"pd_16_com_2audio":"","pd_16_com_2sprite":"","pd_16_com_3iSet":16,"pd_16_com_3oAns":-1,"pd_16_com_3oAct":-1,"pd_16_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_16_com_3extraD":"ExtraData","pd_16_com_3showmore":false,"pd_16_com_3visible":true,"pd_16_com_3audio":"","pd_16_com_3sprite":"","pd_isp_17":false,"pd_rect_17":[4490,50],"pd_comSize_17":1,"pd_ID_17":17,"pd_pTag_17":"","pd_sprite_17":"","pd_expand_17":false,"pd_vars17":0,"pd_17_com_0iSet":17,"pd_17_com_0oAns":20,"pd_17_com_0oAct":-1,"pd_17_com_0text":"W \u017cadnym wypadku! To zjawisko jest przewidywalne i w pe\u0142ni bezpieczne. Dop\u00f3ki ISS utrzymuje swoj\u0105 pr\u0119dko\u015b\u0107 i wysoko\u015b\u0107, b\u0119dziemy w tym samym \u201espadaniu\u201d przez ca\u0142y czas.","pd_17_com_0extraD":"ExtraData","pd_17_com_0showmore":false,"pd_17_com_0visible":true,"pd_17_com_0audio":"","pd_17_com_0sprite":"","pd_isp_18":false,"pd_rect_18":[4490,250],"pd_comSize_18":1,"pd_ID_18":18,"pd_pTag_18":"","pd_sprite_18":"","pd_expand_18":false,"pd_vars18":0,"pd_18_com_0iSet":18,"pd_18_com_0oAns":20,"pd_18_com_0oAct":-1,"pd_18_com_0text":"Dok\u0142adnie! Nasze cia\u0142a, sprz\u0119t, a nawet powietrze wok\u00f3\u0142 nas spadaj\u0105 w tym samym tempie co stacja, wi\u0119c nie czujemy jakby cokolwiek nas przyci\u0105ga\u0142o.","pd_18_com_0extraD":"ExtraData","pd_18_com_0showmore":false,"pd_18_com_0visible":true,"pd_18_com_0audio":"","pd_18_com_0sprite":"","pd_isp_19":false,"pd_rect_19":[4490,-380],"pd_comSize_19":2,"pd_ID_19":19,"pd_pTag_19":"","pd_sprite_19":"","pd_expand_19":false,"pd_vars19":0,"pd_19_com_0iSet":19,"pd_19_com_0oAns":20,"pd_19_com_0oAct":-1,"pd_19_com_0text":"Jasne! Zgodnie z definicj\u0105 niewa\u017cko\u015b\u0107, to stan, kiedy na cia\u0142o nie dzia\u0142aj\u0105 si\u0142y kontaktowe. Wyobra\u017a sobie, \u017ce stoisz na jednej nodze, odczuwasz wtedy na niej ca\u0142y sw\u00f3j ci\u0119\u017car. Gdyby\u015b Twoje cia\u0142o unosi\u0142o si\u0119 w powietrzu, nie da\u0142oby rady okre\u015bli\u0107 w\u0142asnego ci\u0119\u017caru.","pd_19_com_0extraD":"ExtraData","pd_19_com_0showmore":false,"pd_19_com_0visible":true,"pd_19_com_0audio":"","pd_19_com_0sprite":"","pd_19_com_1iSet":19,"pd_19_com_1oAns":-1,"pd_19_com_1oAct":-1,"pd_19_com_1text":"Na stacji kosmicznej grawitacja wci\u0105\u017c dzia\u0142a na astronaut\u00f3w, ale poniewa\u017c ca\u0142a stacja i oni sami znajduj\u0105 si\u0119 w stanie ci\u0105g\u0142ego swobodnego spadku po orbicie, to nie maj\u0105 oparcia, kt\u00f3re wywo\u0142ywa\u0142oby uczucie ci\u0119\u017caru. W efekcie unosz\u0105 si\u0119 wewn\u0105trz stacji i odczuwaj\u0105 stan niewa\u017cko\u015bci.","pd_19_com_1extraD":"ExtraData","pd_19_com_1showmore":false,"pd_19_com_1visible":true,"pd_19_com_1audio":"","pd_19_com_1sprite":"","pd_isp_20":false,"pd_rect_20":[4890,-30],"pd_comSize_20":2,"pd_ID_20":20,"pd_pTag_20":"","pd_sprite_20":"","pd_expand_20":false,"pd_vars20":0,"pd_20_com_0iSet":20,"pd_20_com_0oAns":21,"pd_20_com_0oAct":-1,"pd_20_com_0text":"Widzisz\u2026 Ca\u0142y czas spadamy, ale nigdy nie dotykamy Ziemi, bo poruszamy si\u0119 z ogromn\u0105 pr\u0119dko\u015bci\u0105! Dzi\u0119ki temu nieustannie okr\u0105\u017camy nasz\u0105 planet\u0119. Taka zakrzywiona \u015bcie\u017cka wok\u00f3\u0142 Ziemi to w\u0142a\u015bnie orbita.","pd_20_com_0extraD":"ExtraData","pd_20_com_0showmore":false,"pd_20_com_0visible":true,"pd_20_com_0audio":"","pd_20_com_0sprite":"","pd_20_com_1iSet":20,"pd_20_com_1oAns":-1,"pd_20_com_1oAct":-1,"pd_20_com_1text":"Poniewa\u017c wszystko na stacji spada w tym samym tempie co my, wygl\u0105da to tak, jakby przedmioty i ludzie unosi\u0142y si\u0119 w powietrzu.","pd_20_com_1extraD":"ExtraData","pd_20_com_1showmore":false,"pd_20_com_1visible":true,"pd_20_com_1audio":"","pd_20_com_1sprite":"","pd_isp_21":true,"pd_rect_21":[5300,40],"pd_comSize_21":2,"pd_ID_21":21,"pd_pTag_21":"","pd_sprite_21":"","pd_expand_21":false,"pd_vars21":0,"pd_21_com_0iSet":21,"pd_21_com_0oAns":22,"pd_21_com_0oAct":-1,"pd_21_com_0text":"Wyt\u0142umacz mi jeszcze\u2026","pd_21_com_0extraD":"ExtraData","pd_21_com_0showmore":false,"pd_21_com_0visible":true,"pd_21_com_0audio":"","pd_21_com_0sprite":"","pd_21_com_1iSet":21,"pd_21_com_1oAns":-1,"pd_21_com_1oAct":-1,"pd_21_com_1text":"[Wyjd\u017a z dialogu] Pora na mnie\u2026","pd_21_com_1extraD":"ExtraData","pd_21_com_1showmore":false,"pd_21_com_1visible":true,"pd_21_com_1audio":"","pd_21_com_1sprite":"","pd_isp_22":true,"pd_rect_22":[5710,-180],"pd_comSize_22":3,"pd_ID_22":22,"pd_pTag_22":"","pd_sprite_22":"","pd_expand_22":false,"pd_vars22":0,"pd_22_com_0iSet":22,"pd_22_com_0oAns":23,"pd_22_com_0oAct":-1,"pd_22_com_0text":"O co chodzi\u0142o z tym stanem niewa\u017cko\u015bci i ruchem dooko\u0142a planety?","pd_22_com_0extraD":"ExtraData","pd_22_com_0showmore":false,"pd_22_com_0visible":true,"pd_22_com_0audio":"","pd_22_com_0sprite":"","pd_22_com_1iSet":22,"pd_22_com_1oAns":24,"pd_22_com_1oAct":-1,"pd_22_com_1text":"Co to mikrograwitacja?","pd_22_com_1extraD":"ExtraData","pd_22_com_1showmore":false,"pd_22_com_1visible":true,"pd_22_com_1audio":"","pd_22_com_1sprite":"","pd_22_com_2iSet":22,"pd_22_com_2oAns":25,"pd_22_com_2oAct":-1,"pd_22_com_2text":"Gdzie my jeste\u015bmy?","pd_22_com_2extraD":"ExtraData","pd_22_com_2showmore":false,"pd_22_com_2visible":true,"pd_22_com_2audio":"","pd_22_com_2sprite":"","pd_isp_23":false,"pd_rect_23":[6140,-440],"pd_comSize_23":2,"pd_ID_23":23,"pd_pTag_23":"","pd_sprite_23":"","pd_expand_23":false,"pd_vars23":0,"pd_23_com_0iSet":23,"pd_23_com_0oAns":26,"pd_23_com_0oAct":-1,"pd_23_com_0text":"To po\u0142\u0105czenie si\u0142y grawitacji i ogromnej pr\u0119dko\u015bci. Wyobra\u017a sobie, \u017ce chcesz przeskoczy\u0107 pi\u0142k\u0119. Je\u015bli po prostu skoczysz pionowo, wyl\u0105dujesz na niej. Je\u015bli jednak skoczysz w prz\u00f3d, a jeszcze lepiej, je\u015bli mocno si\u0119 rozp\u0119dzisz, mo\u017cesz j\u0105 przeskoczy\u0107.","pd_23_com_0extraD":"ExtraData","pd_23_com_0showmore":false,"pd_23_com_0visible":true,"pd_23_com_0audio":"","pd_23_com_0sprite":"","pd_23_com_1iSet":23,"pd_23_com_1oAns":-1,"pd_23_com_1oAct":-1,"pd_23_com_1text":"My na ISS jeste\u015bmy tak rozp\u0119dzeni, \u017ce za ka\u017cdym razem \u201eprzeskakujemy\u201d Ziemi\u0119, poruszaj\u0105c si\u0119 w k\u00f3\u0142ko wok\u00f3\u0142 niej. Takie okr\u0105\u017canie planety to ruch po orbicie.","pd_23_com_1extraD":"ExtraData","pd_23_com_1showmore":false,"pd_23_com_1visible":true,"pd_23_com_1audio":"","pd_23_com_1sprite":"","pd_isp_24":false,"pd_rect_24":[6140,-110],"pd_comSize_24":2,"pd_ID_24":24,"pd_pTag_24":"","pd_sprite_24":"","pd_expand_24":false,"pd_vars24":0,"pd_24_com_0iSet":24,"pd_24_com_0oAns":26,"pd_24_com_0oAct":-1,"pd_24_com_0text":"Mikrograwitacja to stan, w kt\u00f3rym grawitacja wci\u0105\u017c dzia\u0142a, ale jej skutki s\u0105 prawie niewyczuwalne.","pd_24_com_0extraD":"ExtraData","pd_24_com_0showmore":false,"pd_24_com_0visible":true,"pd_24_com_0audio":"","pd_24_com_0sprite":"","pd_24_com_1iSet":24,"pd_24_com_1oAns":-1,"pd_24_com_1oAct":-1,"pd_24_com_1text":"W naszym przypadku dzieje si\u0119 tak, poniewa\u017c my i wszystko wok\u00f3\u0142 nas spadamy w tym samym tempie. Nie czujemy wi\u0119c nacisku pod\u0142o\u017ca na nasze cia\u0142a; st\u0105d wra\u017cenie unoszenia si\u0119.","pd_24_com_1extraD":"ExtraData","pd_24_com_1showmore":false,"pd_24_com_1visible":true,"pd_24_com_1audio":"","pd_24_com_1sprite":"","pd_isp_25":false,"pd_rect_25":[6140,140],"pd_comSize_25":2,"pd_ID_25":25,"pd_pTag_25":"","pd_sprite_25":"","pd_expand_25":false,"pd_vars25":0,"pd_25_com_0iSet":25,"pd_25_com_0oAns":26,"pd_25_com_0oAct":-1,"pd_25_com_0text":"Znajdujemy si\u0119 oko\u0142o 400 kilometr\u00f3w nad powierzchni\u0105 Ziemi, na pok\u0142adzie Mi\u0119dzynarodowej Stacji Kosmicznej. Okr\u0105\u017camy planet\u0119 w mniej wi\u0119cej 90 minut, co oznacza, \u017ce ka\u017cdego dnia widzimy wsch\u00f3d i zach\u00f3d S\u0142o\u0144ca a\u017c 16 razy!","pd_25_com_0extraD":"ExtraData","pd_25_com_0showmore":false,"pd_25_com_0visible":true,"pd_25_com_0audio":"","pd_25_com_0sprite":"","pd_25_com_1iSet":25,"pd_25_com_1oAns":-1,"pd_25_com_1oAct":-1,"pd_25_com_1text":"No i od przylotu S\u0142awosza jemy pierogi\u2026 Tak samo ekscytuj\u0105ce!","pd_25_com_1extraD":"ExtraData","pd_25_com_1showmore":false,"pd_25_com_1visible":true,"pd_25_com_1audio":"","pd_25_com_1sprite":"","pd_isp_26":true,"pd_rect_26":[6600,-70],"pd_comSize_26":4,"pd_ID_26":26,"pd_pTag_26":"","pd_sprite_26":"","pd_expand_26":false,"pd_vars26":0,"pd_26_com_0iSet":26,"pd_26_com_0oAns":22,"pd_26_com_0oAct":-1,"pd_26_com_0text":"Wyt\u0142umacz mi jeszcze\u2026","pd_26_com_0extraD":"ExtraData","pd_26_com_0showmore":false,"pd_26_com_0visible":true,"pd_26_com_0audio":"","pd_26_com_0sprite":"","pd_26_com_1iSet":26,"pd_26_com_1oAns":27,"pd_26_com_1oAct":-1,"pd_26_com_1text":"Jasne, dzi\u0119ki! Do zobaczenia!","pd_26_com_1extraD":"ExtraData","pd_26_com_1showmore":false,"pd_26_com_1visible":true,"pd_26_com_1audio":"","pd_26_com_1sprite":"","pd_26_com_2iSet":26,"pd_26_com_2oAns":28,"pd_26_com_2oAct":-1,"pd_26_com_2text":"Widzimy si\u0119 na obiedzie.","pd_26_com_2extraD":"ExtraData","pd_26_com_2showmore":false,"pd_26_com_2visible":true,"pd_26_com_2audio":"","pd_26_com_2sprite":"","pd_26_com_3iSet":26,"pd_26_com_3oAns":29,"pd_26_com_3oAct":-1,"pd_26_com_3text":"Przecie\u017c to wszystko wiedzia\u0142em\u2026 Jestem kosmonaut\u0105!","pd_26_com_3extraD":"ExtraData","pd_26_com_3showmore":false,"pd_26_com_3visible":true,"pd_26_com_3audio":"","pd_26_com_3sprite":"","pd_isp_27":false,"pd_rect_27":[7060,-30],"pd_comSize_27":1,"pd_ID_27":27,"pd_pTag_27":"","pd_sprite_27":"","pd_expand_27":false,"pd_vars27":0,"pd_27_com_0iSet":27,"pd_27_com_0oAns":-1,"pd_27_com_0oAct":-1,"pd_27_com_0text":"Do potem i\u2026 Powodzenia!","pd_27_com_0extraD":"ExtraData","pd_27_com_0showmore":false,"pd_27_com_0visible":true,"pd_27_com_0audio":"","pd_27_com_0sprite":"","pd_isp_28":false,"pd_rect_28":[7060,90],"pd_comSize_28":1,"pd_ID_28":28,"pd_pTag_28":"","pd_sprite_28":"","pd_expand_28":false,"pd_vars28":0,"pd_28_com_0iSet":28,"pd_28_com_0oAns":-1,"pd_28_com_0oAct":-1,"pd_28_com_0text":"Nie przejadaj si\u0119, w ko\u0144cu czeka Ci\u0119 spacer\u2026","pd_28_com_0extraD":"ExtraData","pd_28_com_0showmore":false,"pd_28_com_0visible":true,"pd_28_com_0audio":"","pd_28_com_0sprite":"","pd_isp_29":false,"pd_rect_29":[7060,220],"pd_comSize_29":1,"pd_ID_29":29,"pd_pTag_29":"","pd_sprite_29":"","pd_expand_29":false,"pd_vars29":0,"pd_29_com_0iSet":29,"pd_29_com_0oAns":-1,"pd_29_com_0oAct":-1,"pd_29_com_0text":"Ma\u0142e przypomnienie nikomu jeszcze nie zaszkodzi\u0142o\u2026 Chyba.","pd_29_com_0extraD":"ExtraData","pd_29_com_0showmore":false,"pd_29_com_0visible":true,"pd_29_com_0audio":"","pd_29_com_0sprite":""}