{"dID":67321,"playerDiags":33,"actionNodes":0,"startPoint":0,"loadTag":"","previewPanning":false,"autosave":true,"locEdit":false,"showSettings":false,"pd_isp_0":false,"pd_rect_0":[110,210],"pd_comSize_0":1,"pd_ID_0":0,"pd_pTag_0":"","pd_sprite_0":"","pd_expand_0":false,"pd_vars0":0,"pd_0_com_0iSet":-1,"pd_0_com_0oAns":1,"pd_0_com_0oAct":-1,"pd_0_com_0text":"Hej, tu Wiktoria. Wszystko gra?","pd_0_com_0extraD":"ExtraData","pd_0_com_0showmore":false,"pd_0_com_0visible":true,"pd_0_com_0audio":"","pd_0_com_0sprite":"","pd_isp_1":true,"pd_rect_1":[540,170],"pd_comSize_1":3,"pd_ID_1":1,"pd_pTag_1":"","pd_sprite_1":"","pd_expand_1":false,"pd_vars1":0,"pd_1_com_0iSet":-1,"pd_1_com_0oAns":2,"pd_1_com_0oAct":-1,"pd_1_com_0text":"Wszystko dobrze. Ju\u017c prawie na miejscu.","pd_1_com_0extraD":"ExtraData","pd_1_com_0showmore":false,"pd_1_com_0visible":true,"pd_1_com_0audio":"","pd_1_com_0sprite":"","pd_1_com_1iSet":1,"pd_1_com_1oAns":3,"pd_1_com_1oAct":-1,"pd_1_com_1text":"Radz\u0119 sobie. Ma\u0142ymi krokami do celu.","pd_1_com_1extraD":"ExtraData","pd_1_com_1showmore":false,"pd_1_com_1visible":true,"pd_1_com_1audio":"","pd_1_com_1sprite":"","pd_1_com_2iSet":1,"pd_1_com_2oAns":4,"pd_1_com_2oAct":-1,"pd_1_com_2text":"Ca\u0142kiem nie\u017ale. Widoki s\u0105 niesamowite!","pd_1_com_2extraD":"ExtraData","pd_1_com_2showmore":false,"pd_1_com_2visible":true,"pd_1_com_2audio":"","pd_1_com_2sprite":"","pd_isp_2":false,"pd_rect_2":[950,80],"pd_comSize_2":1,"pd_ID_2":2,"pd_pTag_2":"","pd_sprite_2":"","pd_expand_2":false,"pd_vars2":0,"pd_2_com_0iSet":-1,"pd_2_com_0oAns":5,"pd_2_com_0oAct":-1,"pd_2_com_0text":"Dok\u0142adnie tak! Nie ma co si\u0119 \u015bpieszy\u0107.","pd_2_com_0extraD":"ExtraData","pd_2_com_0showmore":false,"pd_2_com_0visible":true,"pd_2_com_0audio":"","pd_2_com_0sprite":"","pd_isp_3":false,"pd_rect_3":[950,210],"pd_comSize_3":1,"pd_ID_3":3,"pd_pTag_3":"","pd_sprite_3":"","pd_expand_3":false,"pd_vars3":0,"pd_3_com_0iSet":-1,"pd_3_com_0oAns":5,"pd_3_com_0oAct":-1,"pd_3_com_0text":"Tak trzymaj, nie musisz si\u0119 nigdzie \u015bpieszy\u0107.","pd_3_com_0extraD":"ExtraData","pd_3_com_0showmore":false,"pd_3_com_0visible":true,"pd_3_com_0audio":"","pd_3_com_0sprite":"","pd_isp_4":false,"pd_rect_4":[950,340],"pd_comSize_4":1,"pd_ID_4":4,"pd_pTag_4":"","pd_sprite_4":"","pd_expand_4":false,"pd_vars4":0,"pd_4_com_0iSet":-1,"pd_4_com_0oAns":5,"pd_4_com_0oAct":-1,"pd_4_com_0text":"Oj tak. Ziemia st\u0105d jest taka pi\u0119kna!","pd_4_com_0extraD":"ExtraData","pd_4_com_0showmore":false,"pd_4_com_0visible":true,"pd_4_com_0audio":"","pd_4_com_0sprite":"","pd_isp_5":false,"pd_rect_5":[1370,230],"pd_comSize_5":2,"pd_ID_5":5,"pd_pTag_5":"","pd_sprite_5":"","pd_expand_5":false,"pd_vars5":0,"pd_5_com_0iSet":-1,"pd_5_com_0oAns":6,"pd_5_com_0oAct":-1,"pd_5_com_0text":"Po twojej lewej strone powiniene\u015b widzie\u0107 miejsce wycieku powietrza. ","pd_5_com_0extraD":"ExtraData","pd_5_com_0showmore":false,"pd_5_com_0visible":true,"pd_5_com_0audio":"","pd_5_com_0sprite":"","pd_5_com_1iSet":5,"pd_5_com_1oAns":-1,"pd_5_com_1oAct":-1,"pd_5_com_1text":"Daj zna\u0107 czy mog\u0119 Ci jako\u015b pom\u00f3c, albo czy masz jakie\u015b pytania?","pd_5_com_1extraD":"ExtraData","pd_5_com_1showmore":false,"pd_5_com_1visible":true,"pd_5_com_1audio":"","pd_5_com_1sprite":"","pd_isp_6":true,"pd_rect_6":[1750,180],"pd_comSize_6":4,"pd_ID_6":6,"pd_pTag_6":"","pd_sprite_6":"","pd_expand_6":false,"pd_vars6":0,"pd_6_com_0iSet":-1,"pd_6_com_0oAns":9,"pd_6_com_0oAct":-1,"pd_6_com_0text":"Przypomnisz mi prosz\u0119, jaki jest dok\u0142adnie pow\u00f3d tego spaceru.","pd_6_com_0extraD":"ExtraData","pd_6_com_0showmore":false,"pd_6_com_0visible":true,"pd_6_com_0audio":"","pd_6_com_0sprite":"","pd_6_com_1iSet":6,"pd_6_com_1oAns":8,"pd_6_com_1oAct":-1,"pd_6_com_1text":"Szczerze, to troch\u0119 dziwne, \u017ce nie s\u0142ysz\u0119 d\u017awi\u0119k\u00f3w otoczenia\u2026","pd_6_com_1extraD":"ExtraData","pd_6_com_1showmore":false,"pd_6_com_1visible":true,"pd_6_com_1audio":"","pd_6_com_1sprite":"","pd_6_com_2iSet":6,"pd_6_com_2oAns":7,"pd_6_com_2oAct":-1,"pd_6_com_2text":"A tak w\u0142a\u015bciwie\u2026 co dok\u0142adnie robi ten skafander, \u017ce mog\u0119 tu oddycha\u0107?","pd_6_com_2extraD":"ExtraData","pd_6_com_2showmore":false,"pd_6_com_2visible":true,"pd_6_com_2audio":"","pd_6_com_2sprite":"","pd_6_com_3iSet":6,"pd_6_com_3oAns":11,"pd_6_com_3oAct":-1,"pd_6_com_3text":"[Wyjd\u017a z dialogu] Nie mam pyta\u0144. Lec\u0119 dalej! ","pd_6_com_3extraD":"ExtraData","pd_6_com_3showmore":false,"pd_6_com_3visible":true,"pd_6_com_3audio":"","pd_6_com_3sprite":"","pd_isp_7":false,"pd_rect_7":[2170,400],"pd_comSize_7":1,"pd_ID_7":7,"pd_pTag_7":"","pd_sprite_7":"","pd_expand_7":false,"pd_vars7":0,"pd_7_com_0iSet":-1,"pd_7_com_0oAns":10,"pd_7_com_0oAct":-1,"pd_7_com_0text":"To \u015bwietne pytanie! Skafander tworzy dla ciebie co\u015b w rodzaju miniaturowej atmosfery. W \u015brodku jest powietrze pod ci\u015bnieniem, zupe\u0142nie jak na Ziemi. \u017beby lepiej to wyja\u015bni\u0107, zaczn\u0119 od czego\u015b innego\u2026","pd_7_com_0extraD":"ExtraData","pd_7_com_0showmore":false,"pd_7_com_0visible":true,"pd_7_com_0audio":"","pd_7_com_0sprite":"","pd_isp_8":false,"pd_rect_8":[2170,160],"pd_comSize_8":1,"pd_ID_8":8,"pd_pTag_8":"","pd_sprite_8":"","pd_expand_8":false,"pd_vars8":0,"pd_8_com_0iSet":-1,"pd_8_com_0oAns":10,"pd_8_com_0oAct":-1,"pd_8_com_0text":"O, to ciekawa kwestia! Pewnie wiesz, \u017ce d\u017awi\u0119ki brzmi\u0105 zupe\u0142nie inaczej pod wod\u0105 ni\u017c w powietrzu. Wszystko zale\u017cy od tego, gdzie si\u0119 rozchodz\u0105. W kosmosie jednak nie maj\u0105 gdzie si\u0119 rozej\u015b\u0107, wi\u0119c raczej nie us\u0142yszymy otoczenia. A teraz przyjrzyjmy si\u0119 temu troch\u0119 dok\u0142adniej\u2026","pd_8_com_0extraD":"ExtraData","pd_8_com_0showmore":false,"pd_8_com_0visible":true,"pd_8_com_0audio":"","pd_8_com_0sprite":"","pd_isp_9":false,"pd_rect_9":[2170,-10],"pd_comSize_9":1,"pd_ID_9":9,"pd_pTag_9":"","pd_sprite_9":"","pd_expand_9":false,"pd_vars9":0,"pd_9_com_0iSet":-1,"pd_9_com_0oAns":10,"pd_9_com_0oAct":-1,"pd_9_com_0text":"Czujniki wykry\u0142y ma\u0142y wyciek. Na Ziemi nic wielkiego by si\u0119 nie sta\u0142o, ale tutaj, w pr\u00f3\u017cni, r\u00f3\u017cnica ci\u015bnie\u0144 jest ogromna. Ale mo\u017ce zacznijmy od pocz\u0105tku.","pd_9_com_0extraD":"ExtraData","pd_9_com_0showmore":false,"pd_9_com_0visible":true,"pd_9_com_0audio":"","pd_9_com_0sprite":"","pd_isp_10":false,"pd_rect_10":[2610,200],"pd_comSize_10":1,"pd_ID_10":10,"pd_pTag_10":"","pd_sprite_10":"","pd_expand_10":false,"pd_vars10":0,"pd_10_com_0iSet":-1,"pd_10_com_0oAns":12,"pd_10_com_0oAct":-1,"pd_10_com_0text":"Znasz poj\u0119cie pr\u00f3\u017cni? To taki stan, w kt\u00f3rym w danym obszarze znajduje si\u0119 bardzo ma\u0142o cz\u0105steczek materii. Czyli nie ma powietrza lub innych gaz\u00f3w. W idealnej pr\u00f3\u017cni liczba cz\u0105steczek wynosi\u0142aby zero, ale w prawdziwym \u015bwiecie nie da si\u0119 tego osi\u0105gn\u0105\u0107.","pd_10_com_0extraD":"ExtraData","pd_10_com_0showmore":false,"pd_10_com_0visible":true,"pd_10_com_0audio":"","pd_10_com_0sprite":"","pd_isp_11":false,"pd_rect_11":[2170,600],"pd_comSize_11":1,"pd_ID_11":11,"pd_pTag_11":"","pd_sprite_11":"","pd_expand_11":false,"pd_vars11":0,"pd_11_com_0iSet":-1,"pd_11_com_0oAns":-1,"pd_11_com_0oAct":-1,"pd_11_com_0text":"Zrozumia\u0142am, powodzenia!","pd_11_com_0extraD":"ExtraData","pd_11_com_0showmore":false,"pd_11_com_0visible":true,"pd_11_com_0audio":"","pd_11_com_0sprite":"","pd_isp_12":true,"pd_rect_12":[3010,220],"pd_comSize_12":4,"pd_ID_12":12,"pd_pTag_12":"","pd_sprite_12":"","pd_expand_12":false,"pd_vars12":0,"pd_12_com_0iSet":-1,"pd_12_com_0oAns":13,"pd_12_com_0oAct":-1,"pd_12_com_0text":"Czemu to niemo\u017cliwe?","pd_12_com_0extraD":"ExtraData","pd_12_com_0showmore":false,"pd_12_com_0visible":true,"pd_12_com_0audio":"","pd_12_com_0sprite":"","pd_12_com_1iSet":12,"pd_12_com_1oAns":14,"pd_12_com_1oAct":-1,"pd_12_com_1text":"Chyba dalej nie rozumiem, o co chodzi z t\u0105 pr\u00f3\u017cni\u0105.","pd_12_com_1extraD":"ExtraData","pd_12_com_1showmore":false,"pd_12_com_1visible":true,"pd_12_com_1audio":"","pd_12_com_1sprite":"","pd_12_com_2iSet":12,"pd_12_com_2oAns":15,"pd_12_com_2oAct":-1,"pd_12_com_2text":"A jak ta pr\u00f3\u017cnia ma si\u0119 do wycieku, kt\u00f3ry mam naprawi\u0107?","pd_12_com_2extraD":"ExtraData","pd_12_com_2showmore":false,"pd_12_com_2visible":true,"pd_12_com_2audio":"","pd_12_com_2sprite":"","pd_12_com_3iSet":12,"pd_12_com_3oAns":-1,"pd_12_com_3oAct":-1,"pd_12_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_12_com_3extraD":"ExtraData","pd_12_com_3showmore":false,"pd_12_com_3visible":true,"pd_12_com_3audio":"","pd_12_com_3sprite":"","pd_isp_13":false,"pd_rect_13":[3410,20],"pd_comSize_13":1,"pd_ID_13":13,"pd_pTag_13":"","pd_sprite_13":"","pd_expand_13":false,"pd_vars13":0,"pd_13_com_0iSet":-1,"pd_13_com_0oAns":16,"pd_13_com_0oAct":-1,"pd_13_com_0text":"Na orbicie wok\u00f3\u0142 Ziemi prawie nie ma powietrza, ale nie jest ca\u0142kowicie pusto. Nadal unosz\u0105 si\u0119 pojedyncze atomy tlenu, wodoru i helu, a dooko\u0142a kr\u0105\u017c\u0105 cz\u0105stki kosmiczne i drobinki py\u0142u. Dlatego idealnej pr\u00f3\u017cni nie ma nigdzie, nawet w specjalnych laboratoriach czy kosmosie.","pd_13_com_0extraD":"ExtraData","pd_13_com_0showmore":false,"pd_13_com_0visible":true,"pd_13_com_0audio":"","pd_13_com_0sprite":"","pd_isp_14":false,"pd_rect_14":[3410,250],"pd_comSize_14":1,"pd_ID_14":14,"pd_pTag_14":"","pd_sprite_14":"","pd_expand_14":false,"pd_vars14":0,"pd_14_com_0iSet":-1,"pd_14_com_0oAns":16,"pd_14_com_0oAct":-1,"pd_14_com_0text":"Mo\u017cesz my\u015ble\u0107 o pr\u00f3\u017cni jako o \u201eprawie pustej przestrzeni\u201d, gdzie ma\u0142e cz\u0105steczki powietrza s\u0105 bardzo rzadko rozmieszczone.","pd_14_com_0extraD":"ExtraData","pd_14_com_0showmore":false,"pd_14_com_0visible":true,"pd_14_com_0audio":"","pd_14_com_0sprite":"","pd_isp_15":false,"pd_rect_15":[3410,410],"pd_comSize_15":1,"pd_ID_15":15,"pd_pTag_15":"","pd_sprite_15":"","pd_expand_15":false,"pd_vars15":0,"pd_15_com_0iSet":-1,"pd_15_com_0oAns":16,"pd_15_com_0oAct":-1,"pd_15_com_0text":"Po pierwsze, mo\u017cesz rozumie\u0107 ci\u015bnienie, jako parcie na jak\u0105\u015b powierzchni\u0119... W miejscu, kt\u00f3re jest prawie pr\u00f3\u017cni\u0105, ci\u015bnienie jest bardzo niskie. Je\u015bli w tym samym obszarze jest normalne ci\u015bnienie, jak na pok\u0142adzie ISS, powstaje du\u017ca r\u00f3\u017cnica ci\u015bnie\u0144. Powietrze lub p\u0142yn zawsze \u201eucieknie\u201d z obszaru wysokiego ci\u015bnienia do niskiego, dlatego nawet ma\u0142y otw\u00f3r mo\u017ce powodowa\u0107 gwa\u0142towny wyciek.","pd_15_com_0extraD":"ExtraData","pd_15_com_0showmore":false,"pd_15_com_0visible":true,"pd_15_com_0audio":"","pd_15_com_0sprite":"","pd_isp_16":false,"pd_rect_16":[3860,250],"pd_comSize_16":1,"pd_ID_16":16,"pd_pTag_16":"","pd_sprite_16":"","pd_expand_16":false,"pd_vars16":0,"pd_16_com_0iSet":-1,"pd_16_com_0oAns":17,"pd_16_com_0oAct":-1,"pd_16_com_0text":"Pozostaj\u0105c w temacie, pr\u00f3\u017cnia to tylko cz\u0119\u015b\u0107 \u015brodowiska kosmicznego! W kosmosie nie ma atmosfery, wi\u0119c obiekty mog\u0105 do\u015bwiadcza\u0107 bardzo wysokich temperatur w s\u0142o\u0144cu i ekstremalnie niskich w cieniu.","pd_16_com_0extraD":"ExtraData","pd_16_com_0showmore":false,"pd_16_com_0visible":true,"pd_16_com_0audio":"","pd_16_com_0sprite":"","pd_isp_17":true,"pd_rect_17":[4260,250],"pd_comSize_17":4,"pd_ID_17":17,"pd_pTag_17":"","pd_sprite_17":"","pd_expand_17":false,"pd_vars17":0,"pd_17_com_0iSet":-1,"pd_17_com_0oAns":18,"pd_17_com_0oAct":-1,"pd_17_com_0text":"Jaka jest r\u00f3\u017cnica mi\u0119dzy Ziemi\u0105 a kosmosem?","pd_17_com_0extraD":"ExtraData","pd_17_com_0showmore":false,"pd_17_com_0visible":true,"pd_17_com_0audio":"","pd_17_com_0sprite":"","pd_17_com_1iSet":17,"pd_17_com_1oAns":19,"pd_17_com_1oAct":-1,"pd_17_com_1text":"To dlaczego w stacji kosmicznej i w skafanderze mam normaln\u0105 temperatur\u0119?","pd_17_com_1extraD":"ExtraData","pd_17_com_1showmore":false,"pd_17_com_1visible":true,"pd_17_com_1audio":"","pd_17_com_1sprite":"","pd_17_com_2iSet":17,"pd_17_com_2oAns":20,"pd_17_com_2oAct":-1,"pd_17_com_2text":"Czy co\u015b mi grozi?","pd_17_com_2extraD":"ExtraData","pd_17_com_2showmore":false,"pd_17_com_2visible":true,"pd_17_com_2audio":"","pd_17_com_2sprite":"","pd_17_com_3iSet":17,"pd_17_com_3oAns":-1,"pd_17_com_3oAct":-1,"pd_17_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_17_com_3extraD":"ExtraData","pd_17_com_3showmore":false,"pd_17_com_3visible":true,"pd_17_com_3audio":"","pd_17_com_3sprite":"","pd_isp_18":false,"pd_rect_18":[4720,20],"pd_comSize_18":1,"pd_ID_18":18,"pd_pTag_18":"","pd_sprite_18":"","pd_expand_18":false,"pd_vars18":0,"pd_18_com_0iSet":-1,"pd_18_com_0oAns":21,"pd_18_com_0oAct":-1,"pd_18_com_0text":"Na Ziemi atmosfera w pewnym sensie zatrzymuje ciep\u0142o i rozprowadza je r\u00f3wnomiernie. W kosmosie brak powietrza oznacza, \u017ce nie ma bardzo skutecznego rodzaju wymiany ciep\u0142a. To jeden z wielu powod\u00f3w, dla kt\u00f3rych Tw\u00f3j skafander jest niezb\u0119dny do tego typu misji.","pd_18_com_0extraD":"ExtraData","pd_18_com_0showmore":false,"pd_18_com_0visible":true,"pd_18_com_0audio":"","pd_18_com_0sprite":"","pd_isp_19":false,"pd_rect_19":[4720,260],"pd_comSize_19":1,"pd_ID_19":19,"pd_pTag_19":"","pd_sprite_19":"","pd_expand_19":false,"pd_vars19":0,"pd_19_com_0iSet":-1,"pd_19_com_0oAns":21,"pd_19_com_0oAct":-1,"pd_19_com_0text":"Bo zar\u00f3wno stacja, jak i skafander maj\u0105 systemy regulacji temperatury. One tworz\u0105 dla Ciebie bezpieczne \u015brodowisko. Poza tym sama orbita i moment Twojego spaceru zosta\u0142y odpowiednio dobrane, nie m\u00f3wi\u0105c ju\u017c o szczeg\u00f3\u0142owym projekcie samej stacji kosmicznej i skafandra!","pd_19_com_0extraD":"ExtraData","pd_19_com_0showmore":false,"pd_19_com_0visible":true,"pd_19_com_0audio":"","pd_19_com_0sprite":"","pd_isp_20":false,"pd_rect_20":[4720,500],"pd_comSize_20":1,"pd_ID_20":20,"pd_pTag_20":"","pd_sprite_20":"","pd_expand_20":false,"pd_vars20":0,"pd_20_com_0iSet":-1,"pd_20_com_0oAns":21,"pd_20_com_0oAct":-1,"pd_20_com_0text":"Nie. Zar\u00f3wno stacja, jak i skafander maj\u0105 systemy regulacji temperatury. One tworz\u0105 dla Ciebie bezpieczne \u015brodowisko. Problem pojawia si\u0119 dopiero, gdy co\u015b przestaje dzia\u0142a\u0107, dlatego ka\u017cdy wyciek czy awaria musi by\u0107 naprawiona.","pd_20_com_0extraD":"ExtraData","pd_20_com_0showmore":false,"pd_20_com_0visible":true,"pd_20_com_0audio":"","pd_20_com_0sprite":"","pd_isp_21":false,"pd_rect_21":[5130,320],"pd_comSize_21":2,"pd_ID_21":21,"pd_pTag_21":"","pd_sprite_21":"","pd_expand_21":false,"pd_vars21":0,"pd_21_com_0iSet":-1,"pd_21_com_0oAns":22,"pd_21_com_0oAct":-1,"pd_21_com_0text":"Jest jeszcze jeden istotny skutek wyj\u015bcia z atmosfery ziemskiej: promieniowanie kosmiczne.","pd_21_com_0extraD":"ExtraData","pd_21_com_0showmore":false,"pd_21_com_0visible":true,"pd_21_com_0audio":"","pd_21_com_0sprite":"","pd_21_com_1iSet":21,"pd_21_com_1oAns":-1,"pd_21_com_1oAct":-1,"pd_21_com_1text":"To niewidzialne cz\u0105steczki, kt\u00f3re lec\u0105 z kosmosu z ogromn\u0105 pr\u0119dko\u015bci\u0105. Nasza atmosfera i pole magnetyczne Ziemi zwykle nas przed nimi chroni\u0105, ale w kosmosie ta ochrona znika. Dlatego astronauci i satelity musz\u0105 uwa\u017ca\u0107, bo takie promieniowanie mo\u017ce uszkadza\u0107 elektronik\u0119 i szkodzi\u0107 zdrowiu ludzi.","pd_21_com_1extraD":"ExtraData","pd_21_com_1showmore":false,"pd_21_com_1visible":true,"pd_21_com_1audio":"","pd_21_com_1sprite":"","pd_isp_22":true,"pd_rect_22":[5550,340],"pd_comSize_22":4,"pd_ID_22":22,"pd_pTag_22":"","pd_sprite_22":"","pd_expand_22":false,"pd_vars22":0,"pd_22_com_0iSet":-1,"pd_22_com_0oAns":23,"pd_22_com_0oAct":-1,"pd_22_com_0text":"Co grozi ludziom, a co satelitom?","pd_22_com_0extraD":"ExtraData","pd_22_com_0showmore":false,"pd_22_com_0visible":true,"pd_22_com_0audio":"","pd_22_com_0sprite":"","pd_22_com_1iSet":22,"pd_22_com_1oAns":24,"pd_22_com_1oAct":-1,"pd_22_com_1text":"Czy promieniowanie kosmiczne dociera te\u017c na Ziemi\u0119?","pd_22_com_1extraD":"ExtraData","pd_22_com_1showmore":false,"pd_22_com_1visible":true,"pd_22_com_1audio":"","pd_22_com_1sprite":"","pd_22_com_2iSet":22,"pd_22_com_2oAns":25,"pd_22_com_2oAct":-1,"pd_22_com_2text":"Czy to promieniowanie jest jak \u015bwiat\u0142o albo promienie rentgenowskie?","pd_22_com_2extraD":"ExtraData","pd_22_com_2showmore":false,"pd_22_com_2visible":true,"pd_22_com_2audio":"","pd_22_com_2sprite":"","pd_22_com_3iSet":22,"pd_22_com_3oAns":-1,"pd_22_com_3oAct":-1,"pd_22_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_22_com_3extraD":"ExtraData","pd_22_com_3showmore":false,"pd_22_com_3visible":true,"pd_22_com_3audio":"","pd_22_com_3sprite":"","pd_isp_23":false,"pd_rect_23":[5950,110],"pd_comSize_23":1,"pd_ID_23":23,"pd_pTag_23":"","pd_sprite_23":"","pd_expand_23":false,"pd_vars23":0,"pd_23_com_0iSet":-1,"pd_23_com_0oAns":26,"pd_23_com_0oAct":-1,"pd_23_com_0text":"Promieniowanie kosmiczne mo\u017ce psu\u0107 komputery w satelitach i statkach kosmicznych. Dla ludzi jest gro\u017ane, bo mo\u017ce uszkadza\u0107 kom\u00f3rki w ciele, a nawet wywo\u0142a\u0107 choroby! Im d\u0142u\u017cej cz\u0142owiek czy maszyna przebywa w kosmosie, tym bardziej jest nara\u017cony na promieniowanie.","pd_23_com_0extraD":"ExtraData","pd_23_com_0showmore":false,"pd_23_com_0visible":true,"pd_23_com_0audio":"","pd_23_com_0sprite":"","pd_isp_24":false,"pd_rect_24":[5950,340],"pd_comSize_24":1,"pd_ID_24":24,"pd_pTag_24":"","pd_sprite_24":"","pd_expand_24":false,"pd_vars24":0,"pd_24_com_0iSet":-1,"pd_24_com_0oAns":26,"pd_24_com_0oAct":-1,"pd_24_com_0text":"Tak, ale na Ziemi jeste\u015bmy bezpieczni. Atmosfera i pole magnetyczne zatrzymuj\u0105 wi\u0119kszo\u015b\u0107 promieniowania, wi\u0119c dociera do nas tylko ma\u0142a cz\u0119\u015b\u0107 i nie jest tam dla nas szkodliwe. Poza atmosfer\u0105 dawka jest o wiele wi\u0119ksza.","pd_24_com_0extraD":"ExtraData","pd_24_com_0showmore":false,"pd_24_com_0visible":true,"pd_24_com_0audio":"","pd_24_com_0sprite":"","pd_isp_25":false,"pd_rect_25":[5950,560],"pd_comSize_25":1,"pd_ID_25":25,"pd_pTag_25":"","pd_sprite_25":"","pd_expand_25":false,"pd_vars25":0,"pd_25_com_0iSet":-1,"pd_25_com_0oAns":26,"pd_25_com_0oAct":-1,"pd_25_com_0text":"To bardzo dobre skojarzenie. Natomiast promieniowanie kosmiczne jest jednak szerszym zjawiskiem. Mo\u017cesz rozumie\u0107 je jako strumie\u0144 bardzo szybkich ma\u0142ych cz\u0105stek, kt\u00f3rych uderzenie wywo\u0142uje powa\u017cne szkody.","pd_25_com_0extraD":"ExtraData","pd_25_com_0showmore":false,"pd_25_com_0visible":true,"pd_25_com_0audio":"","pd_25_com_0sprite":"","pd_isp_26":false,"pd_rect_26":[6450,310],"pd_comSize_26":1,"pd_ID_26":26,"pd_pTag_26":"","pd_sprite_26":"","pd_expand_26":false,"pd_vars26":0,"pd_26_com_0iSet":-1,"pd_26_com_0oAns":27,"pd_26_com_0oAct":-1,"pd_26_com_0text":"O ile promieniowanie jest niewidoczne, \u015bmieci kosmiczne i ma\u0142e meteoryty da si\u0119 dostrzec. Poza przypadkami spadaj\u0105cych gwiazd, b\u0119dzie to bardzo trudne go\u0142ym okiem. Wci\u0105\u017c, s\u0105 one stale \u015bledzone przez naukowc\u00f3w, poniewa\u017c zderzenie mog\u0142oby oznacza\u0107 powa\u017cne uszkodzenia, a nawet koniec misji.","pd_26_com_0extraD":"ExtraData","pd_26_com_0showmore":false,"pd_26_com_0visible":true,"pd_26_com_0audio":"","pd_26_com_0sprite":"","pd_isp_27":true,"pd_rect_27":[6890,410],"pd_comSize_27":4,"pd_ID_27":27,"pd_pTag_27":"","pd_sprite_27":"","pd_expand_27":false,"pd_vars27":0,"pd_27_com_0iSet":-1,"pd_27_com_0oAns":28,"pd_27_com_0oAct":-1,"pd_27_com_0text":"Czy naprawd\u0119 ma\u0142e kamienie mog\u0105 uszkodzi\u0107 wielk\u0105 stacj\u0119 kosmiczn\u0105?","pd_27_com_0extraD":"ExtraData","pd_27_com_0showmore":false,"pd_27_com_0visible":true,"pd_27_com_0audio":"","pd_27_com_0sprite":"","pd_27_com_1iSet":27,"pd_27_com_1oAns":29,"pd_27_com_1oAct":-1,"pd_27_com_1text":"Comment...W jaki spos\u00f3b Ziemia chroni si\u0119 przed nimi?","pd_27_com_1extraD":"ExtraData","pd_27_com_1showmore":false,"pd_27_com_1visible":true,"pd_27_com_1audio":"","pd_27_com_1sprite":"","pd_27_com_2iSet":27,"pd_27_com_2oAns":30,"pd_27_com_2oAct":-1,"pd_27_com_2text":"Jak je \u015bledzimy, skoro s\u0105 ma\u0142e i szybkie?","pd_27_com_2extraD":"ExtraData","pd_27_com_2showmore":false,"pd_27_com_2visible":true,"pd_27_com_2audio":"","pd_27_com_2sprite":"","pd_27_com_3iSet":27,"pd_27_com_3oAns":-1,"pd_27_com_3oAct":-1,"pd_27_com_3text":"[Wyjd\u017a z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!","pd_27_com_3extraD":"ExtraData","pd_27_com_3showmore":false,"pd_27_com_3visible":true,"pd_27_com_3audio":"","pd_27_com_3sprite":"","pd_isp_28":false,"pd_rect_28":[7280,230],"pd_comSize_28":1,"pd_ID_28":28,"pd_pTag_28":"","pd_sprite_28":"","pd_expand_28":false,"pd_vars28":0,"pd_28_com_0iSet":-1,"pd_28_com_0oAns":31,"pd_28_com_0oAct":-1,"pd_28_com_0text":"Tak! W kosmosie nawet male\u0144ki kawa\u0142ek ska\u0142y lec\u0105cy z ogromn\u0105 pr\u0119dko\u015bci\u0105 mo\u017ce zrobi\u0107 powa\u017cne szkody.","pd_28_com_0extraD":"ExtraData","pd_28_com_0showmore":false,"pd_28_com_0visible":true,"pd_28_com_0audio":"","pd_28_com_0sprite":"","pd_isp_29":false,"pd_rect_29":[7280,390],"pd_comSize_29":1,"pd_ID_29":29,"pd_pTag_29":"","pd_sprite_29":"","pd_expand_29":false,"pd_vars29":0,"pd_29_com_0iSet":-1,"pd_29_com_0oAns":31,"pd_29_com_0oAct":-1,"pd_29_com_0text":"Wi\u0119kszo\u015b\u0107 meteoryt\u00f3w spala si\u0119 w atmosferze, zanim dotr\u0105 do powierzchni. Atmosfera dzia\u0142a jak gigantyczna tarcza, kt\u00f3ra chroni nas przed ma\u0142ymi kosmicznymi obiektami.","pd_29_com_0extraD":"ExtraData","pd_29_com_0showmore":false,"pd_29_com_0visible":true,"pd_29_com_0audio":"","pd_29_com_0sprite":"",