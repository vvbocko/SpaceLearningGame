        height: 76
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Ca\u0142kiem nie\u017Ale adaptujemy si\u0119 do tak trudnych warunk\xF3w."
      extraData: ExtraData
      inputSetIndex: 16
      outputNodeIndex: 19
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 170
        width: 30
        height: 32
