      y: -110
      width: 348
      height: 255.33334
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 2
    s_comment:
    - text: "Znajdujemy si\u0119 oko\u0142o 400 kilometr\xF3w nad powierzchni\u0105
        Ziemi, na pok\u0142adzie Mi\u0119dzynarodowej Stacji Kosmicznej. Okr\u0105\u017Camy
        planet\u0119 w mniej wi\u0119cej 90 minut, co oznacza, \u017Ce ka\u017Cdego
        dnia widzimy wsch\xF3d i zach\xF3d S\u0142o\u0144ca a\u017C 16 razy!"
      extraData: ExtraData
      inputSetIndex: 25
      outputNodeIndex: 26
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 134
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "No i od przylotu S\u0142awosza jemy pierogi\u2026 Tak samo ekscytuj\u0105ce!"
      extraData: ExtraData
      inputSetIndex: 25
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
