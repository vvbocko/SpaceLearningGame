    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 1
    s_comment:
    - text: "Jasne, daj sobie czas. Jestem pewna, \u017Ce nied\u0142ugo poczujesz
