    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 1
    s_comment:
    - text: "To normalne. Wa\u017Cne, aby obserwowa\u0107 swoje reakcje. Gdyby co\u015B
