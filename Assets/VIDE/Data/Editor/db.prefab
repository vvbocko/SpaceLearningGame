      y: -70
      width: 348
      height: 232.66667
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 1
  - commentCount: 2
    s_comment:
    - text: "Wyobra\u017A sobie, \u017Ce nurkujesz! Twoje cia\u0142o unosi si\u0119
        i wystarczy delikatne pchni\u0119cie, by pop\u0142yn\u0105\u0107, gdzie tylko
        chcesz."
      extraData: ExtraData
      inputSetIndex: 3
      outputNodeIndex: 2
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 61
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Oczywi\u015Bcie, na orbicie jest nieco inaczej\u2026 Panuje tu stan
        mikrograwitacji i ka\u017Cdy przedmiot czy cz\u0142owiek mog\u0105 wydawa\u0107
        si\u0119 lekkie jak pi\xF3rko."
      extraData: ExtraData
      inputSetIndex: 3
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 4
    rect:
      serializedVersion: 2
