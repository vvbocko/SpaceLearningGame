        y: 61
        width: 30
        height: 22
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "[Wyjd\u017A z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!Pora
        na mnie\u2026"
      extraData: ExtraData
      inputSetIndex: 21
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
