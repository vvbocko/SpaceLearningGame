      y: 220
      width: 348
      height: 149.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 1
    s_comment:
    - text: "To normalne. Wa\u017Cne, \u017Ceby obserwowa\u0107 swoje reakcje i zg\u0142asza\u0142
        wszelkie dolegliwo\u015Bci."
      extraData: ExtraData
      inputSetIndex: 4
      outputNodeIndex: 5
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 4
    rect:
      serializedVersion: 2
      x: 990
      y: 360
      width: 348
      height: 149.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "To normalne, \u017Ce organizm reaguje inaczej poza Ziemi\u0105. "
      extraData: ExtraData
      inputSetIndex: 5
      outputNodeIndex: 6
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Wi\u0119kszo\u015B\u0107 kosmonaut\xF3w na pocz\u0105tku do\u015Bwiadcza
        \"Syndromu Adaptacji Kosmicznej\""
      extraData: ExtraData
      inputSetIndex: 5
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "\u2026 Zwykle objawia si\u0119 to tym, \u017Ce czuj\u0105 si\u0119 jakby
        byli do g\xF3ry nogami, albo ci\u0119\u017Cej wyczu\u0107 im po\u0142o\u017Cenie
        r\u0105k czy n\xF3g."
      extraData: ExtraData
      inputSetIndex: 5
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 5
    rect:
      serializedVersion: 2
      x: 1400
      y: 210
      width: 348
      height: 244
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "Czuj\u0119 si\u0119\u2026 inaczej, ale chyba nie jest ze mn\u0105 a\u017C
        tak \u017Ale. Czy to mi grozi?"
      extraData: ExtraData
      inputSetIndex: 6
      outputNodeIndex: 9
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "A wi\u0119c to mi dolega. Powiedz mi co mnie czeka."
      extraData: ExtraData
      inputSetIndex: 6
      outputNodeIndex: 8
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 108
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Dlaczego to takie cz\u0119ste?"
