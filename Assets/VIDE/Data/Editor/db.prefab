    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "Ca\u0142e szcz\u0119\u015Bcie! Rozumiem, \u017Ce po tym b\u0119dzie
        ju\u017C z g\xF3rki?"
      extraData: ExtraData
      inputSetIndex: 16
