      height: 299.3333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 2
    s_comment:
    - text: "Wyt\u0142umacz mi jeszcze\u2026"
      extraData: ExtraData
      inputSetIndex: 21
      outputNodeIndex: 22
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
