  - commentCount: 2
    s_comment:
    - text: "Hej, jestem Mateusz i w imieniu za\u0142ogi: witamy na Mi\u0119dzynarodowej
        Stacji Kosmicznej (ISS)!"
      extraData: ExtraData
      inputSetIndex: 0
      outputNodeIndex: 1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 61
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Jak si\u0119 czujesz?"
      extraData: ExtraData
      inputSetIndex: 0
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
