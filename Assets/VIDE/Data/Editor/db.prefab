      y: -210
      width: 348
      height: 164
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 1
    s_comment:
    - text: "Ha! To dobra metafora tego, co si\u0119 dzieje."
      extraData: ExtraData
      inputSetIndex: 5
      outputNodeIndex: 3
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
