      y: -90
      width: 348
      height: 240.66666
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 1
    s_comment:
    - text: "Nie ma co si\u0119 dziwi\u0107! Ci\u0119\u017Cko to por\xF3wna\u0107
        do czegokolwiek na Ziemi. Cho\u0107 przychodzi mi na my\u015Bl jedna rzecz\u2026"
      extraData: ExtraData
      inputSetIndex: 4
      outputNodeIndex: 3
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
