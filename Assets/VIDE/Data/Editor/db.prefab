  S_playerDiags:
  - commentCount: 2
    s_comment:
    - text: "Witamy na pok\u0142adzie Mi\u0119dzynarodowej Stacji Kosmicznej!"
      extraData: ExtraData
      inputSetIndex: 0
      outputNodeIndex: 1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Niez\u0142e uczucie by\u0107 w stanie niewa\u017Cko\u015Bci, prawda?\t\r"
      extraData: ExtraData
      inputSetIndex: 0
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
