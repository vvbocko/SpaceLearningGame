      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 2
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Dobrze. Przyzwyczajam si\u0119, cho\u0107 to dla mnie nowa sytuacja."
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 3
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Czuj\u0119 si\u0119 dziwnie\u2026 Stan niewa\u017Cko\u015Bci jest troch\u0119
        przyt\u0142aczaj\u0105cy."
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 4
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 126
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 1
    rect:
