      y: 140
      width: 348
      height: 214.66666
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 1
  - commentCount: 1
    s_comment:
    - text: "To dobry znak. Nie ma co si\u0119 \u015Bpieszy\u0107. Jestem pewna,
