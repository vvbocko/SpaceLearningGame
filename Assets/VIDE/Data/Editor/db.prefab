      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 90
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Natomiast je\u015Bli jeste\u015Bmy bardzo daleko od pewnego obiektu,
        to grawitacja mo\u017Ce by\u0107 tak ma\u0142a, \u017Ce prawie nieodczuwalna."
      extraData: ExtraData
      inputSetIndex: 10
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Tak wi\u0119c to jak przyci\u0105ganie grawitacyjne dzia\u0142a na dwa
