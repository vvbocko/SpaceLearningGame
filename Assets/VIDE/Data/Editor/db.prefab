      y: 80
      width: 348
      height: 149.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 1
    s_comment:
    - text: "Jasne, daj sobie czas. Jestem pewna, \u017Ce nied\u0142ugo b\u0119dziesz
        czu\u0107 si\u0119 \u015Bwietnie."
      extraData: ExtraData
      inputSetIndex: 3
      outputNodeIndex: 5
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
