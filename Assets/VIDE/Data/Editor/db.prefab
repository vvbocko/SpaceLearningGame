      width: 348
      height: 187
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "Czuj\u0119 si\u0119 dziwnie, wszystko si\u0119 unosi\u2026"
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 4
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "To niesamowite! Czuj\u0119 si\u0119 jak ryba w wodzie."
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 5
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Troch\u0119 mi niedobrze."
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 6
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 126
        width: 30
        height: 22
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 1
    rect:
      serializedVersion: 2
      x: 380
      y: -60
      width: 348
      height: 190.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 1
  - commentCount: 4
    s_comment:
    - text: "Bo s\u0105 lekkie jak pi\xF3rko - nie ma grawitacji."
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: 9
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Rzeczy maj\u0105 mas\u0119, Ziemia ma mas\u0119, wi\u0119c grawitacja
        dzia\u0142a!"
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: 8
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Czy to znaczy, \u017Ce tu nie dzia\u0142a grawitacja?"
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: 7
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 126
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "[Wyjd\u017A z dialogu] Dzi\u0119ki za rozmow\u0119, ale misja czeka!"
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
