    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 2
    s_comment:
    - text: "W naszym ciele mamy specjalny system, kt\xF3ry pomaga nam utrzyma\u0107
        r\xF3wnowag\u0119."
      extraData: ExtraData
      inputSetIndex: 10
      outputNodeIndex: 11
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Sk\u0142ada si\u0119 on z ucha wewn\u0119trznego i receptor\xF3w w mi\u0119\u015Bniach
        i stawach, kt\xF3re przekazuj\u0105 m\xF3zgowi informacje o po\u0142o\u017Ceniu
        i ruchu naszego cia\u0142a."
      extraData: ExtraData
      inputSetIndex: 10
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
