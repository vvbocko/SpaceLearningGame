      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Jasne! Ale z tego co kojarz\u0119, przebywanie w warunkach mikrograwitacji
        wp\u0142ywa na znacznie wiele aspket\xF3w organizmu."
      extraData: ExtraData
      inputSetIndex: 16
      outputNodeIndex: 18
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
