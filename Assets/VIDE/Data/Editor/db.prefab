    ID: 0
    rect:
      serializedVersion: 2
      x: 200
      y: 170
      width: 348
      height: 149.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "Potrzebuj\u0119 jeszcze troch\u0119 czasu, ale z ka\u017Cd\u0105 godzin\u0105
        coraz lepiej. "
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 2
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Dobrze. Przyzwyczajam si\u0119, cho\u0107 to dla mnie nowa sytuacja."
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 3
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Czuj\u0119 si\u0119 dziwnie\u2026 Stan niewa\u017Cko\u015Bci jest troch\u0119
        przyt\u0142aczaj\u0105cy."
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 4
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 126
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 1
    rect:
      serializedVersion: 2
      x: 580
      y: 140
      width: 348
      height: 214.66666
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 1
  - commentCount: 1
    s_comment:
    - text: "To dobry znak. Nie ma co si\u0119 \u015Bpieszy\u0107. Jestem pewna,
        \u017Ce przywykniesz."
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: 5
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
