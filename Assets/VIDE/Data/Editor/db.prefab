  S_playerDiags:
  - commentCount: 1
    s_comment:
    - text: "Cze\u015B\u0107, nazywam si\u0119 Wiktoria. Jestem pok\u0142adowym doktorem.
        Jak si\u0119 czujesz?"
      extraData: ExtraData
      inputSetIndex: 0
      outputNodeIndex: 1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
      sprites: {fileID: 0}
