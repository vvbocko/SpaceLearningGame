      width: 348
      height: 328.66666
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 2
    s_comment:
    - text: "Mikrograwitacja to stan, w kt\xF3rym grawitacja wci\u0105\u017C dzia\u0142a,
        ale jej skutki s\u0105 prawie niewyczuwalne."
      extraData: ExtraData
      inputSetIndex: 24
      outputNodeIndex: 26
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 61
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "W naszym przypadku dzieje si\u0119 tak, poniewa\u017C my i wszystko
        wok\xF3\u0142 nas spadamy w tym samym tempie. Nie czujemy wi\u0119c nacisku
        pod\u0142o\u017Ca na nasze cia\u0142a; st\u0105d wra\u017Cenie unoszenia
        si\u0119."
      extraData: ExtraData
      inputSetIndex: 24
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 24
    rect:
      serializedVersion: 2
