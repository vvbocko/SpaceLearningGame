      width: 348
      height: 182
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "To niesamowite! Chcia\u0142bym tak zawsze. "
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 2
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Dziwne uczucie, wszystko si\u0119 unosi\u2026"
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 2
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Troch\u0119 mi niedobrze\u2026"
      extraData: ExtraData
      inputSetIndex: 1
      outputNodeIndex: 2
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 126
        width: 30
        height: 22
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 1
    rect:
      serializedVersion: 2
      x: 380
      y: -60
      width: 348
      height: 190.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 1
  - commentCount: 2
    s_comment:
    - text: "Nie ma co si\u0119 dziwi\u0107, jest zupe\u0142nie inaczej ni\u017C
        na Ziemi\u2026"
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: 3
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "W mikrograwitacji ka\u017Cdy wszystko wydaje si\u0119 lekkie jak pi\xF3rko!"
      extraData: ExtraData
      inputSetIndex: 2
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 2
    rect:
      serializedVersion: 2
      x: 760
      y: -60
      width: 348
      height: 182
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "To dlatego, \u017Ce tutaj nie ma grawitacji?"
      extraData: ExtraData
      inputSetIndex: 3
      outputNodeIndex: 4
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "A nie powinno nas ci\u0105gn\u0105\u0107 w d\xF3\u0142\u2026 jak na
        Ziemi?"
      extraData: ExtraData
      inputSetIndex: 3
      outputNodeIndex: 4
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 94
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "To\u2026 jak to w\u0142a\u015Bciwie dzia\u0142a?"
      extraData: ExtraData
      inputSetIndex: 3
      outputNodeIndex: 4
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 126
        width: 30
        height: 22
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    ID: 3
    rect:
      serializedVersion: 2
      x: 1140
      y: -60
      width: 348
      height: 190.33333
    pTag: 
    expand: 0
    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 1
  - commentCount: 4
    s_comment:
    - text: "Grawitacja dzia\u0142a i to jak!"
      extraData: ExtraData
      inputSetIndex: 4
      outputNodeIndex: 5
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 22
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "W\u0142a\u015Bciwie to w\u0142a\u015Bnie dzi\u0119ki niej tu jeste\u015Bmy."
      extraData: ExtraData
      inputSetIndex: 4
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "ISS nie wisi w kosmosie, tylko ca\u0142y czas spada w stron\u0119 Ziemi!"
      extraData: ExtraData
      inputSetIndex: 4
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 0
        height: 0
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Tylko, \u017Ce porusza si\u0119 tak szybko do przodu, \u017Ce zamiast
        spa\u015B\u0107, nieustannie j\u0105 okr\u0105\u017Ca."
      extraData: ExtraData
      inputSetIndex: 4
      outputNodeIndex: -1
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 0
        y: 0
