      inputSetIndex: 6
      outputNodeIndex: 7
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 141
        width: 30
        height: 22
      sprites: {fileID: 0}
      audios: {fileID: 0}
