    sprite: {fileID: 0}
    vars: []
    varKeys: []
    isPlayer: 0
  - commentCount: 3
    s_comment:
    - text: "To dlatego astronauci cz\u0119sto maj\u0105 nabrzmia\u0142e twarze i
        jednocze\u015Bnie \u201Echudsze\u201D nogi!"
      extraData: ExtraData
      inputSetIndex: 21
      outputNodeIndex: 24
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 301
        y: 61
        width: 30
        height: 46
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "To musi prowadzi\u0107 do wielu problem\xF3w zdrowotnych."
      extraData: ExtraData
      inputSetIndex: 21
      outputNodeIndex: 22
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 108
        width: 30
        height: 32
      sprites: {fileID: 0}
      audios: {fileID: 0}
      visible: 1
    - text: "Jak mog\u0119 temu przeciwdzia\u0142a\u0107?"
      extraData: ExtraData
      inputSetIndex: 21
      outputNodeIndex: 23
      outActionIndex: -1
      showmore: 0
      outRect:
        serializedVersion: 2
        x: 300
        y: 141
